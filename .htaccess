# Para hospedagens Apache (Hostinger, HostGator, Locaweb etc.)

# 1) Força HTTPS e o endereço sem "www"
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aepseguranca.com.br%{REQUEST_URI} [L,R=301]

# 2) Compressão (página carrega mais rápido)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>

# 3) Cache no navegador (visitas seguintes quase instantâneas)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
